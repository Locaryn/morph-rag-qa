{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-rag-qa",
  "version": "1.0.0-beta.1",
  "description": "Répondre à partir de vos documents : découpage, plongements calculés par le moteur local, recherche par similarité. Rien ne quitte la machine.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-rag-qa",
  "repository": "https://github.com/Locaryn/morph-rag-qa",
  "keywords": [
    "rag",
    "question-answering",
    "vector-store",
    "embeddings",
    "pdf-search",
    "semantic-search"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur de vectorisation et recherche sémantique locale."
    },
    "files.read": {
      "reason": "Lire les documents PDF, Markdown et code sources à indexer."
    },
    "files.write": {
      "reason": "Stocker la base vectorielle locale et les index."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "rag-qa"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "rag-qa-catalog",
        "slot": "marketplace.catalogs",
        "order": 17,
        "type": "data",
        "label": "Modèles d'embeddings & RAG",
        "icon": "question",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles d'embedding BGE et Nomic au catalogue"
      },
      {
        "id": "rag-qa-studio",
        "slot": "studio.tabs",
        "order": 17,
        "label": "Q&R Documents (RAG)",
        "icon": "question",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-rag-qa-panel",
        "hint": "Indexation de dossiers et requêtes documentaires"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "1.0.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (Pre-release) — non testée par des utilisateurs",
      "tag": "v1.0.0-beta.1",
      "released_at": "2026-08-28"
    },
    {
      "version": "0.9.0",
      "is_beta": false,
      "summary": "Version de référence stable",
      "tag": "v0.9.0",
      "released_at": "2026-08-20"
    },
    {
      "version": "0.8.5",
      "is_beta": false,
      "summary": "Version précédente stable",
      "tag": "v0.8.5",
      "released_at": "2026-08-15"
    },
    {
      "version": "0.8.0",
      "is_beta": false,
      "summary": "Version initiale du socle",
      "tag": "v0.8.0",
      "released_at": "2026-08-01"
    }
  ]
}
